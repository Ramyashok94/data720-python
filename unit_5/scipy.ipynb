   "id": "e2f113dc",
   "metadata": {},
   "source": [
    "### Integration example\n",
    "* Compute the integral $\\int_0^2 e^{-t} dt$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "7ad4095c",
   "metadata": {},
   "outputs": [],
   "source": [
    "def f(t):\n",
    "    return exp(-t)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "ed083a25",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0.8646647167633872\n"
     ]
    }
   ],
   "source": [
    "res,err = quad(f,0,2)\n",
    "print(res)"
   ]
  },
